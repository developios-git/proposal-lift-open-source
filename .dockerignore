coverage
*.log
*.tsbuildinfo

# Docker's own files
Dockerfile
Dockerfile.*
docker-compose.yml
.dockerignore

# Schema and local-stack config. Nothing in the image reads these: the
# migration is applied by hand in the Supabase SQL editor before first start,
# and config.toml only configures the local dev stack.
supabase
