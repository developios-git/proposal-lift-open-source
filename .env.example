# ============================================================================
# Copy to .env and fill in. Everything here comes from your own Supabase
# project — create a free one at https://supabase.com first.
#
#   cp .env.example .env
#   docker compose up --build
#
# The database schema is NOT applied from here. Paste
# supabase/migrations/20260828000000_baseline.sql into your project's SQL
# editor before the first start — see README.md.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase API  —  Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Your public address. It goes inside confirmation and reset emails, so set it
# to the real one before self-hosting. On Vercel, leave it blank: each
# deployment uses its own domain, and a value here would send preview
# deployments to production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ---------------------------------------------------------------------------
# Upwork credential encryption  —  REQUIRED
#
# Your Upwork app's client secret is encrypted at rest with this key. Without
# it, saving Upwork credentials in Settings fails outright.
#
# Generate one (64 hex characters = 32 bytes):
#   openssl rand -hex 32
#
# Changing this key makes every already-stored secret undecryptable, and each
# user has to re-enter their Upwork credentials. Set it once, keep it.
# ---------------------------------------------------------------------------
UPWORK_CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI key encryption  —  REQUIRED
#
# Each user's OpenAI and Anthropic API keys are encrypted at rest with this
# key. Without it, saving an AI key in Settings fails with a message saying so.
#
# Generate one (64 hex characters = 32 bytes), separate from the Upwork key
# above so the two can be rotated independently:
#   openssl rand -hex 32
#
# Changing this key makes every already-encrypted API key unreadable, and each
# user has to re-enter theirs in Settings. Set it once, keep it.
#
# Upgrading an existing install: keys saved before this variable existed are
# stored in plain text and keep working untouched. They are encrypted only when
# a user next saves one.
# ---------------------------------------------------------------------------
AI_KEYS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Upwork OAuth redirect  —  REQUIRED
#
# Must match the Redirect URI you registered on your own Upwork developer app
# exactly, including scheme, host, port and path. A mismatch fails the OAuth
# handshake at Upwork's end, before the app ever sees the request.
#
#   local:  http://localhost:3000/auth/upwork/callback
#   hosted: https://your-domain.example/auth/upwork/callback
# ---------------------------------------------------------------------------
UPWORK_REDIRECT_URI=http://localhost:3000/auth/upwork/callback

# ---------------------------------------------------------------------------
# Google sign-in (optional)
#
# Set to `true` ONLY after enabling the Google provider in your Supabase
# dashboard (Authentication > Providers > Google). Supabase holds the Google
# client id and secret — this app never sees them — so this flag is the only
# thing telling the login and signup pages whether the button will work.
#
# Left blank, email/password is the only way in.
# ---------------------------------------------------------------------------
GOOGLE_AUTH_ENABLED=

# ---------------------------------------------------------------------------
# Email  —  https://resend.com
# Required for job-alert notifications.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# ---------------------------------------------------------------------------
# Scheduled job alerts (optional)
#
# Alerts do not fire until you set up a scheduler. This only works on a
# publicly reachable deployment — see docs/cron.md.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Chrome extension (optional)
#
# The extension's Chrome Web Store id. Every install carries the same one, so
# it is filled in below already and a normal self-hosted install needs no
# change here.
#
# Running an UNPACKED development build instead? Chrome generates a fresh id
# for those at load time, and the server has no way to guess it: replace the
# value below with the id from chrome://extensions, then restart. Accepts a
# comma-separated list.
#
# Note: extension sign-in also uses SUPABASE_SECRET_KEY above. It is required
# for the whole app — signup needs it too, and the server refuses to start
# without it.
# ---------------------------------------------------------------------------
PUBLISHED_EXTENSION_ID=pmbimligkdnacbjijogfpejadehdihpk

# ---------------------------------------------------------------------------
# Rate limiting (optional)
# Leave blank to disable. The app runs fine without it.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# NOTE: there is no OpenAI or Anthropic key here.
# AI keys are per-user: each account adds its own in Settings after signing up.
# ---------------------------------------------------------------------------
